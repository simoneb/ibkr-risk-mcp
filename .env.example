# --------------------------------------------------------------------------
# How the server is served
# --------------------------------------------------------------------------
#
# "stdio" (the default) is a server the client launches as a subprocess and
# talks to over a pipe — the desktop extension, an `mcpServers` entry, `uvx`.
# "http" serves streamable HTTP instead, for a server running somewhere the
# client cannot launch it.
#
# Read the three variables below as belonging to the *server*, not to IB.
# IBKR_HOST and IBKR_PORT further down are TWS's; these are this process's, and
# in the deployment they exist for the two are not the same machine.
# IBKR_MCP_TRANSPORT=stdio

# Where the HTTP transport listens, and the path the MCP endpoint is mounted
# at. Loopback by default: the intended shape puts a reverse proxy in front to
# terminate TLS and carry authentication, so binding a public interface should
# be something you typed on purpose.
# IBKR_MCP_HOST=127.0.0.1
# IBKR_MCP_PORT=8765
# IBKR_MCP_PATH=/mcp

# Whether the HTTP transport requires a bearer token. Off by default and
# meaningless under stdio, where the client already launched the process.
#
# With it on, this server becomes an OAuth 2.1 *resource server*: it verifies
# tokens an external identity provider issued and never sees a credential
# itself. There is no login here, no client secret and no user database.
# IBKR_MCP_AUTH=false

# The identity provider, and where it publishes its signing keys. The JWKS URL
# defaults to the conventional path under the issuer, which is right for most
# providers and wrong for enough of them to be worth overriding.
# IBKR_MCP_AUTH_ISSUER=https://your-tenant.example.com/
# IBKR_MCP_AUTH_JWKS_URL=

# This server's own public URL, published for discovery, and the audience a
# token must name. They are usually the same string; they are separate because
# providers differ — some mint the resource URL, others an opaque API
# identifier chosen at registration. The audience check is not a formality:
# without it, a token your provider issued for a different application of yours
# would open this one.
# IBKR_MCP_RESOURCE_URL=https://risk.example.com/mcp
# IBKR_MCP_AUTH_AUDIENCE=

# Who may use this server, by token subject, comma separated.
#
# Read this as the whole of the authorisation model. There is one IB account
# behind this process and the tools read it whoever asks, so a token cannot
# select whose data comes back — identity here admits a caller, it does not
# route them. A valid token from the right provider naming somebody not on this
# list is a stranger holding a complete position book.
#
# An empty list never means "everyone": with auth on, the server refuses to
# start without one.
# IBKR_MCP_ALLOWED_SUBJECTS=

# The scope granted to an allowlisted subject and required of every request.
# This server grants it rather than believing a scope claim the provider put in
# the token — so a provider handing out scopes freely cannot widen access here.
#
# It is still published for discovery, and Claude asks the provider for it by
# name, so it must be a scope your provider will actually issue. `openid` is
# the default because every OIDC provider has it. A custom name like
# `risk:read` works too, but define it as a permission at the provider first,
# or the authorization request is rejected before a token is ever minted.
# IBKR_MCP_AUTH_SCOPE=openid

# Two of these are checked at startup rather than left to fail at connection
# time: every auth URL must be https (loopback excepted, for the local test),
# and IBKR_MCP_RESOURCE_URL must end at IBKR_MCP_PATH, because Claude compares
# the published resource against the URL typed into the connector dialog
# character for character.

# --------------------------------------------------------------------------
# Interactive Brokers
# --------------------------------------------------------------------------

# TWS or IB Gateway must be running on this machine with the API enabled:
# File > Global Configuration > API > Settings > "Enable ActiveX and Socket
# Clients". Default ports are 7496 (TWS live), 7497 (TWS paper), 4001 (Gateway
# live) and 4002 (Gateway paper).
IBKR_HOST=127.0.0.1
IBKR_PORT=7496

# TWS refuses a second connection on a client id already in use, so this must
# not collide with any other script pointed at the same TWS. Never 0 — TWS
# reserves that id for orders placed by hand in the GUI.
IBKR_CLIENT_ID=17

# Only needed on a multi-account login, where IB reports every account at once
# and adding them together means nothing.
# IBKR_ACCOUNT=U1234567

# 1 live, 2 frozen, 3 delayed, 4 delayed-frozen.
#
# Contrary to what is widely repeated, delayed data DOES carry model greeks —
# IB publishes them on the delayed option-computation tick. Verified against
# live TWS: on an account without the market data subscription, types 1 and 2
# returned nothing at all while type 3 returned implied volatilities. So 3 is a
# working fallback, not a broken mode; the values are about fifteen minutes old.
IBKR_MARKET_DATA_TYPE=1

# Safety gate for whatif_order, the only tool that touches IB's order path.
# whatIf=True orders are evaluated by IB's margin engine and never routed, but
# the gate exists so that being read-only is provable rather than asserted.
# With it false the tool sends nothing at all and returns blocked:true.
#
# Note that it also decides how the API connection itself is opened: false
# connects read-only, which makes an order impossible below this server as well
# as inside it.
IBKR_ENABLE_WHATIF=false

# Whether to ask IB to imply a volatility for an option it would not publish
# model greeks for, using reqCalcImpliedVolatility.
#
# Off by default, and not out of caution. Measured against live TWS: ib_async's
# request for this comes back as error 320 — "Please use 'Key=Value' format for
# Misc Options" — and TWS then CLOSES THE API CONNECTION. Losing the socket
# halfway through a portfolio load is much worse than the single contract it was
# trying to price, and the local fallback covers that contract anyway.
#
# When a TWS build does accept it, it is the better answer: IB's own
# American-exercise model rather than a European volatility implied locally. Try
# it if you like; it disables itself for the rest of the session after one
# failure. Either way the row is stamped with where its numbers came from.
IBKR_USE_IB_IMPLIED_VOL=false

# Rate used to discount and to carry spot to the forward in the local
# repricing. IB does not publish the rate behind its own model, so this is an
# input rather than a measurement.
IBKR_RISK_FREE_RATE=0.04

# How long to wait for IB to push model greeks for one contract, and how many
# market data lines to keep open at once. IB allows roughly 50 concurrent lines
# and 100 messages a second; every subscription here is cancelled as soon as
# its data arrives.
IBKR_GREEKS_TIMEOUT=4
IBKR_MAX_MKT_DATA_LINES=40

# How long to wait for IB to answer a what-if order. It does not always answer
# at all — TWS drops the request silently when the contract cannot be priced —
# so this is a real bound, not a formality. When one times out the remaining
# legs are not attempted, since they would fail the same way.
IBKR_WHATIF_TIMEOUT=5

# Where the fitted vol_coord decay is stored. The calibrate_vol_coord tool
# writes the fit here and every later stress_curve reads it, so a calibration
# made once against your own Risk Navigator holds across sessions instead of
# reverting to the number this server shipped with. Defaults to
# ~/.ibkr-risk-mcp/vol_coord.json. It is the only file this server writes.
# IBKR_CALIBRATION_FILE=
